# Sentinel Monitor backend — environment template.
# Copy to backend/.env for local development (that file is gitignored —
# never commit real secrets). The backend boots with dev fallbacks even
# without a .env file, but production MUST set the SENTINEL_* variables
# in the real environment.
#
# Generate a secret key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

SENTINEL_SECRET_KEY=replace-me-with-a-long-random-string
SENTINEL_DEBUG=1
SENTINEL_ALLOWED_HOSTS=localhost,127.0.0.1
SENTINEL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Database — engine switch: sqlite (dev/tests) | postgresql (production)
# ---------------------------------------------------------------------------
SENTINEL_DB_ENGINE=sqlite

# PostgreSQL (used only when SENTINEL_DB_ENGINE=postgresql).
# Driver: pip install "psycopg[binary]>=3.2,<4.0"
SENTINEL_DB_NAME=sentinel
SENTINEL_DB_USER=sentinel
SENTINEL_DB_PASSWORD=
SENTINEL_DB_HOST=127.0.0.1
SENTINEL_DB_PORT=5432
SENTINEL_DB_CONN_MAX_AGE=60
